        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Figura 4. Máquina de estados UML 2.5 — ciclo de vida de Request" style="text;html=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#173d2b;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="25" width="1220" height="38" />
        </mxCell>
        <mxCell id="subtitle" value="UML 2.5 State Machine · Sección 14 · Fuente: RequestStatus.java (máquina de estados) y RequestService.java" style="text;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#48564d;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="65" width="1220" height="25" />
        </mxCell>

        <!-- Initial pseudostate -->
        <mxCell id="initial" style="ellipse;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="60" y="295" width="20" height="20" />
        </mxCell>

        <!-- PENDING state -->
        <mxCell id="pending" value="PENDING" style="swimlane;startSize=42;horizontal=1;rounded=0;html=0;fontFamily=Helvetica;fontSize=17;fontStyle=1;fillColor=#eaf2ec;swimlaneFillColor=#ffffff;strokeColor=#395e48;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="150" y="170" width="300" height="270" />
        </mxCell>
        <mxCell id="pending_body" value="entry / status = PENDING&#10;entry / trackingCode = generate(8)&#10;do / canBeEdited() = true&#10;do / canBeDeleted() = true&#10;── internal ──&#10;edit() [canBeEdited()] / update fields&#10;delete() [canBeDeleted()] / remove request" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#25362b;" parent="pending" vertex="1">
          <mxGeometry as="geometry" x="0" y="42" width="300" height="228" />
        </mxCell>

        <!-- IN_PROGRESS state -->
        <mxCell id="inprogress" value="IN_PROGRESS" style="swimlane;startSize=42;horizontal=1;rounded=0;html=0;fontFamily=Helvetica;fontSize=17;fontStyle=1;fillColor=#eaf2ec;swimlaneFillColor=#ffffff;strokeColor=#395e48;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="570" y="100" width="280" height="180" />
        </mxCell>
        <mxCell id="inprogress_body" value="entry / confirmedSlot = slot&#10;entry / status = IN_PROGRESS&#10;do / canBeEdited() = false&#10;do / canBeDeleted() = false&#10;exit / lock release (@Version)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#25362b;" parent="inprogress" vertex="1">
          <mxGeometry as="geometry" x="0" y="42" width="280" height="138" />
        </mxCell>

        <!-- COMPLETED state -->
        <mxCell id="completed" value="COMPLETED" style="swimlane;startSize=42;horizontal=1;rounded=0;html=0;fontFamily=Helvetica;fontSize=17;fontStyle=1;fillColor=#eaf2ec;swimlaneFillColor=#ffffff;strokeColor=#395e48;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="970" y="100" width="240" height="130" />
        </mxCell>
        <mxCell id="completed_body" value="entry / status = COMPLETED&#10;do / canBeEdited() = false&#10;do / canBeDeleted() = false" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#25362b;" parent="completed" vertex="1">
          <mxGeometry as="geometry" x="0" y="42" width="240" height="88" />
        </mxCell>

        <!-- REJECTED state -->
        <mxCell id="rejected" value="REJECTED" style="swimlane;startSize=42;horizontal=1;rounded=0;html=0;fontFamily=Helvetica;fontSize=17;fontStyle=1;fillColor=#eaf2ec;swimlaneFillColor=#ffffff;strokeColor=#395e48;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="570" y="470" width="280" height="130" />
        </mxCell>
        <mxCell id="rejected_body" value="entry / status = REJECTED&#10;do / canBeEdited() = false&#10;do / canBeDeleted() = false" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#25362b;" parent="rejected" vertex="1">
          <mxGeometry as="geometry" x="0" y="42" width="280" height="88" />
        </mxCell>

        <!-- Final pseudostate -->
        <mxCell id="final_outer" style="ellipse;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1080" y="295" width="30" height="30" />
        </mxCell>
        <mxCell id="final_inner" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1087" y="302" width="16" height="16" />
        </mxCell>

        <!-- Junction pseudostate -->
        <mxCell id="junction" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="704" y="349" width="12" height="12" />
        </mxCell>

        <!-- ====== Transitions ====== -->

        <!-- Initial → PENDING -->
        <mxCell id="t_init" value="create()&#10;[user ∨ guest] / new Request" style="endArrow=open;startArrow=none;html=0;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#344239;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.3;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="initial" target="pending">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>

        <!-- PENDING → IN_PROGRESS -->
        <mxCell id="t_accept" value="accept(slot)&#10;[PENDING ∧ slot ≠ null]&#10;/ confirmedSlot = slot" style="endArrow=open;startArrow=none;html=0;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#344239;strokeWidth=1.4;exitX=1;exitY=0.2;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="pending" target="inprogress">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>

        <!-- PENDING → REJECTED -->
        <mxCell id="t_reject_pending" value="reject()&#10;[PENDING]&#10;/ status = REJECTED" style="endArrow=open;startArrow=none;html=0;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#344239;strokeWidth=1.4;exitX=1;exitY=0.8;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="pending" target="rejected">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="490" y="386" />
              <mxPoint x="490" y="535" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- IN_PROGRESS → COMPLETED -->
        <mxCell id="t_complete" value="complete()&#10;[IN_PROGRESS]&#10;/ status = COMPLETED" style="endArrow=open;startArrow=none;html=0;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#344239;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="inprogress" target="completed">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>

        <!-- IN_PROGRESS → junction -->
        <mxCell id="t_reject_progress" value="reject()&#10;[IN_PROGRESS]" style="endArrow=open;startArrow=none;html=0;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#344239;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="inprogress" target="junction">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>

        <!-- junction → REJECTED -->
        <mxCell id="t_junc_rejected" style="endArrow=open;startArrow=none;html=0;strokeColor=#344239;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="junction" target="rejected">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>

        <!-- COMPLETED → final -->
        <mxCell id="t_completed_final" style="endArrow=open;startArrow=none;html=0;strokeColor=#344239;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="completed" target="final_outer">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1250" y="165" />
              <mxPoint x="1250" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- REJECTED → final -->
        <mxCell id="t_rejected_final" style="endArrow=open;startArrow=none;html=0;strokeColor=#344239;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" parent="1" edge="1" source="rejected" target="final_outer">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="920" y="535" />
              <mxPoint x="920" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ====== Notes ====== -->
        <mxCell id="note_locking" value="Nota — Optimistic Locking:&#10;todas las transiciones están protegidas con @Version.&#10;Si dos operadores actúan simultáneamente, la segunda&#10;transición lanza OptimisticLockingFailureException.&#10;El patrón State (RequestStatus.java) encapsula las&#10;transiciones válidas en cada estado y rechaza las&#10;inválidas con IllegalStateException." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=13;fontColor=#48564d;fillColor=#ffffff;strokeColor=#dce5de;strokeWidth=1;rounded=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="150" y="640" width="340" height="120" />
        </mxCell>

        <mxCell id="note_legend" value="Lectura UML 2.5:&#10;● = pseudosestado inicial    ◉ = pseudosestado final    ⬤ = junction&#10;entry / = acción de entrada    exit / = acción de salida    do / = actividad continua&#10;evento [guardia] / acción = sintaxis de transición&#10;Transición interna (edit, delete) = no dispara entry/exit, no cambia de estado" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=13;fontColor=#48564d;fillColor=#ffffff;strokeColor=#dce5de;strokeWidth=1;rounded=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="530" y="640" width="360" height="110" />
        </mxCell>

        <mxCell id="note_notify" value="Nota — Notificaciones:&#10;accept() y reject() persisten una Notification&#10;in-app para el solicitante registrado DESPUÉS&#10;del save (si el save falla por concurrencia,&#10;no se notifica). complete() no notifica.&#10;El invitado no tiene bandeja: consulta por&#10;teléfono + código de rastreo." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=13;fontColor=#48564d;fillColor=#ffffff;strokeColor=#dce5de;strokeWidth=1;rounded=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="930" y="630" width="280" height="130" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

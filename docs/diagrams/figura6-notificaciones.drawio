        <mxCell id="note-conflict" value="Conflicto de concurrencia: si el save del paso 5&#10;falla por @Version (dos operadores sobre la misma&#10;solicitud), la transición no se persistió → el paso 7&#10;no se ejecuta. Nadie es notificado de un estado&#10;que no existe en la base." style="shape=note;size=15;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=13;fillColor=#fafbf9;strokeColor=#87948a;" parent="1" vertex="1"><mxGeometry x="90" y="700" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="note-reject" value="reject() sigue el mismo flujo&#10;con NotificationType.REJECTED.&#10;complete() no notifica." style="shape=note;size=15;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=13;fillColor=#fafbf9;strokeColor=#87948a;" parent="1" vertex="1"><mxGeometry x="90" y="490" width="290" height="100" as="geometry"/></mxCell>


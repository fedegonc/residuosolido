# ========================================
# GITIGNORE ROBUSTO PARA SPRING BOOT
# ========================================

# ========================================
# VARIABLES DE ENTORNO
# ========================================

.env
*.env
env.properties

# ========================================
# MARKDOWN SUELTO (notas/narraciones de sesión)
# ========================================
# Solo afecta .md NUEVOS (no trackeados). Los ya versionados (README.md,
# docs/*.md: MEJORAS, DEFENSA, ENDPOINTS, INDICE, DIAGRAMAS, METODOLOGIA,
# BOILERPLATE_VS_CORE) siguen trackeados igual — gitignore no los saca del
# repo, solo evita que un .md nuevo suelto se sume sin pasar por el sistema
# de docs canónico (ver docs/INDICE.md).
*.md
!README.md
!CLAUDE.md
!docs/INDICE.md
!docs/DEFENSA.md
!docs/DIAGRAMAS.md
!docs/ENDPOINTS.md
!docs/MEJORAS.md
!docs/METODOLOGIA.md
!docs/BOILERPLATE_VS_CORE.md
!docs/SEGURIDAD.md
!docs/REQUISITOS.md
!docs/REQUERIMIENTOS.md
!docs/ARQUITECTURA.md
!docs/TRADEOFFS.md
!docs/COPIES.md
!docs/AUDITORIA.md
!docs/USABILIDAD.md
!docs/tesis/CONTEXTO_LLM.md
# docs/referencia/: material de respaldo (auditorías, historial de
# hardening) — fuera del INDICE principal pero versionado igual.
!docs/referencia/CORRECCIONES.md
!docs/referencia/GITFLOW.md
!.agents/skills/emil-design-eng/SKILL.md


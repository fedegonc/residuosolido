# Plantilla de variables de entorno — copiar a `.env` (gitignored) y completar
# con valores reales. `.env` es leído automáticamente por Spring Boot vía
# spring.config.import=optional:file:.env[.properties] (application.properties).
# Ver docs/DEFENSA.md §26 para el tradeoff completo.

# Obligatoria — connection string de MongoDB Atlas (Database Access → usuario/password)
SPRING_DATA_MONGODB_URI=mongodb+srv://usuario:password@fedelabs.jlujsms.mongodb.net/?appName=fedelabs

# Opcionales — valores por defecto en application.properties si se omiten
MONGODB_DATABASE=fedelabs
UPLOAD_DIR=uploads
